---
import { PUBLIC_BRAND_NAME } from 'astro:env/client';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-10 flex flex-col md:flex-row gap-6 md:items-center justify-between text-sm text-muted">
    <div class="flex items-center gap-2">
      <span class="text-xl">🔥</span>
      <span class="font-display font-extrabold text-ink">{PUBLIC_BRAND_NAME}</span>
      <span>· © {year}</span>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="/#sedes" class="hover:text-ink">Sedes</a>
      <span>Pagos seguros con <strong class="text-ink">Wompi</strong></span>
      <a href="/admin" class="hover:text-ink">Administración</a>
    </div>
  </div>
</footer>
