---
import Layout from '../layouts/Layout.astro';
---
<Layout title="No encontrado">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <div class="text-8xl floaty inline-block">🍟</div>
    <h1 class="font-display text-5xl font-extrabold mt-6">Ups, esto no está en el menú</h1>
    <p class="text-muted mt-3">La página que buscas no existe o se movió.</p>
    <a href="/" class="btn-primary mt-8">Volver al inicio</a>
  </div>
</Layout>
