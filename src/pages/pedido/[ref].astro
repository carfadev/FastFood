---
import Layout from '../../layouts/Layout.astro';
import { getOrderPublic, verifyTransactionId } from '../../lib/orders.js';
import { money, ORDER_STATUS, PAYMENT_STATUS, TONE } from '../../lib/format.js';

const { ref } = Astro.params;
// Wompi redirige con ?id=<transaction_id>: verificamos de inmediato (no dependemos solo del webhook)
const txId = Astro.url.searchParams.get('id');
if (txId) await verifyTransactionId(txId).catch((e) => console.error(e));

const order = await getOrderPublic(ref).catch(() => null);
if (!order) return Astro.rewrite('/404');

const flow = order.fulfillment === 'delivery'
  ? ['new', 'confirmed', 'preparing', 'on_the_way', 'delivered']
  : ['new', 'confirmed', 'preparing', 'ready', 'delivered'];
const step = flow.indexOf(order.status);
const cancelled = order.status === 'cancelled';
const needsPay = order.payment_method === 'wompi' && order.payment_status !== 'approved' && !cancelled;
const pay = PAYMENT_STATUS[order.payment_status];
const wa = order.branch?.whatsapp
  ? `https://wa.me/${order.branch.whatsapp}?text=${encodeURIComponent(`Hola 👋 tengo una consulta sobre mi pedido ${order.reference}`)}`
  : null;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title={`Pedido ${order.reference}`} hideCart>
  <div class="mx-auto max-w-3xl px-4 py-10" id="order" data-ref={order.reference} data-status={order.status} data-pay={order.payment_status}>
    <!-- Encabezado -->
    <div class="text-center rise">
      <div class="text-7xl floaty inline-block">{cancelled ? '😕' : needsPay ? '💳' : ORDER_STATUS[order.status].icon}</div>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold mt-4">
        {cancelled ? 'Pedido cancelado' : needsPay ? (order.payment_status === 'pending' ? 'Esperando tu pago' : 'El pago no se completó') : '¡Pedido recibido!'}
      </h1>
      <p class="text-muted mt-2">
        {needsPay && order.payment_status !== 'pending'
          ? 'Puedes intentarlo de nuevo o cambiar a pago contraentrega escribiendo a la sede.'
          : `Gracias ${order.customer_name.split(' ')[0]}. ${order.branch?.name} ya está en ello.`}
      </p>
      <div class="mt-4 inline-flex items-center gap-2 card px-4 py-2 font-mono text-sm">
        <span class="text-muted">Referencia</span><strong>{order.reference}</strong>
        <button data-copy={order.reference} class="text-primary text-xs font-sans font-semibold">Copiar</button>
      </div>
    </div>

    {needsPay && (
      <div class="card mt-8 p-6 text-center border-warning/40">
        <span class:list={['badge', TONE[pay.tone]]}>{pay.label}</span>
        <p class="mt-3 text-muted text-sm">Total a pagar: <strong class="text-ink">{money(order.total)}</strong></p>
        <button id="retry" class="btn-primary mt-4">Pagar con Wompi</button>
      </div>
    )}

    <!-- Tracker -->
    {!cancelled && !needsPay && (
      <div class="card mt-8 p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display text-xl font-bold">Estado</h2>
          <span class="text-xs text-muted flex items-center gap-1.5"><span class="size-2 rounded-full bg-success animate-pulse"></span>Se actualiza solo</span>
        </div>
        <ol class="relative grid grid-cols-5 gap-1">
          {flow.map((s, i) => (
            <li class="flex flex-col items-center text-center gap-2">
              <span class:list={['grid place-items-center size-11 rounded-full text-xl border-2 transition',
                i < step ? 'bg-primary border-primary' : i === step ? 'bg-primary/15 border-primary animate-pulse' : 'bg-surface-2 border-line opacity-50']}>
                {ORDER_STATUS[s].icon}
              </span>
              <span class:list={['text-[11px] sm:text-xs leading-tight', i <= step ? 'text-ink font-semibold' : 'text-muted']}>{ORDER_STATUS[s].label}</span>
            </li>
          ))}
        </ol>
        <p class="text-center text-sm text-muted mt-6">Tiempo estimado: <strong class="text-ink">~{order.branch?.eta_minutes ?? 35} min</strong></p>
      </div>
    )}

    <!-- Detalle -->
    <div class="card mt-6 p-6">
      <div class="flex flex-wrap justify-between gap-2 mb-4">
        <h2 class="font-display text-xl font-bold">Detalle</h2>
        <div class="flex gap-2">
          <span class="badge bg-surface-2 text-ink">{order.fulfillment === 'delivery' ? '🛵 Domicilio' : '🏃 Recoger'}</span>
          <span class="badge bg-surface-2 text-ink">{order.payment_method === 'wompi' ? '💳 Wompi' : '💵 Contraentrega'}</span>
        </div>
      </div>
      <ul class="divide-y divide-line">
        {order.items.map((i) => (
          <li class="py-3 flex justify-between gap-4">
            <div><p><span class="text-primary font-bold">{i.quantity}×</span> {i.name}</p>{i.notes && <p class="text-xs text-muted">{i.notes}</p>}</div>
            <span class="shrink-0">{money(i.line_total)}</span>
          </li>
        ))}
      </ul>
      <div class="border-t border-line mt-2 pt-4 space-y-1 text-sm">
        <div class="flex justify-between text-muted"><span>Subtotal</span><span>{money(order.subtotal)}</span></div>
        <div class="flex justify-between text-muted"><span>Domicilio</span><span>{order.delivery_fee ? money(order.delivery_fee) : '—'}</span></div>
        <div class="flex justify-between font-display text-2xl font-extrabold pt-2"><span>Total</span><span>{money(order.total)}</span></div>
      </div>
      <div class="mt-5 text-sm text-muted">
        {order.fulfillment === 'delivery' ? <p>📍 Entrega en: <span class="text-ink">{order.address}</span></p> : <p>📍 Recoge en: <span class="text-ink">{order.branch?.address}</span></p>}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3 justify-center">
      {wa && <a href={wa} target="_blank" rel="noopener" class="btn-ghost">💬 Escribir a la sede</a>}
      <a href={`/sede/${order.branch?.slug}`} class="btn-ghost">🍔 Pedir de nuevo</a>
    </div>
  </div>
</Layout>

<script>
  const root = document.getElementById('order');
  const ref = root.dataset.ref;

  document.querySelector('[data-copy]')?.addEventListener('click', (e) => {
    navigator.clipboard?.writeText(e.currentTarget.dataset.copy);
    e.currentTarget.textContent = '¡Copiado!';
  });

  document.getElementById('retry')?.addEventListener('click', async (e) => {
    e.currentTarget.disabled = true;
    const r = await fetch(`/api/orders/${ref}`, { method: 'POST' });
    const d = await r.json();
    if (d.checkoutUrl) location.href = d.checkoutUrl; else { alert(d.error || 'No fue posible'); e.currentTarget.disabled = false; }
  });

  // Seguimiento: consulta cada 12 s y recarga si cambia el estado.
  const final = ['delivered', 'cancelled'];
  if (!final.includes(root.dataset.status)) {
    const tick = async () => {
      if (document.hidden) return;
      try {
        const r = await fetch(`/api/orders/${ref}`, { cache: 'no-store' });
        const o = await r.json();
        if (o.status !== root.dataset.status || o.payment_status !== root.dataset.pay) location.replace(`/pedido/${ref}`);
      } catch {}
    };
    setInterval(tick, 12000);
  }
</script>
