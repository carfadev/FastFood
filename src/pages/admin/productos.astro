---
import AdminLayout from '../../layouts/AdminLayout.astro';
const owner = Astro.locals.admin.role === 'owner';
---
<AdminLayout title="Productos">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl font-extrabold">Productos</h1>
      <p class="text-muted text-sm">Catálogo global · disponibilidad y precio por sede.</p>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <input id="search" class="input !w-56 !py-2" placeholder="Buscar…" />
      <select id="branch" class="input !w-auto !py-2"></select>
      {owner && <button id="new" class="btn-primary btn-sm">+ Nuevo producto</button>}
    </div>
  </div>

  <div class="card mt-6 overflow-x-auto">
    <table class="w-full text-sm min-w-[760px]">
      <thead><tr>
        <th class="th">Producto</th><th class="th">Categoría</th><th class="th">Precio base</th>
        <th class="th" id="th-branch">Disponible en sede</th><th class="th">Precio en sede</th>
        {owner && <th class="th">Activo</th>}{owner && <th class="th"></th>}
      </tr></thead>
      <tbody id="rows"><tr><td class="td text-muted" colspan="7">Cargando…</td></tr></tbody>
    </table>
  </div>

  {owner && (
    <dialog id="dlg" class="m-auto w-[min(560px,94vw)] rounded-brand bg-surface border border-line p-0 shadow-2xl">
      <form id="form" method="dialog" class="p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 id="dlg-title" class="font-display text-2xl font-extrabold">Producto</h2>
          <button type="button" data-close class="size-9 rounded-full bg-surface-2">✕</button>
        </div>
        <input type="hidden" name="id" />
        <div class="flex gap-4 items-center">
          <label class="relative size-28 shrink-0 rounded-2xl bg-surface-2 border border-dashed border-line grid place-items-center overflow-hidden cursor-pointer hover:border-primary">
            <img id="preview" class="absolute inset-0 size-full object-cover hidden" alt="" />
            <span class="text-xs text-muted text-center px-2">📷<br/>Subir imagen</span>
            <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/avif" class="sr-only" />
          </label>
          <div class="flex-1 space-y-3">
            <div><label class="label">Nombre</label><input name="name" required class="input" /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class="label">Precio (COP)</label><input name="price" type="number" min="0" step="100" required data-num class="input" /></div>
              <div><label class="label">Orden</label><input name="sort" type="number" data-num data-default="0" class="input" /></div>
            </div>
          </div>
        </div>
        <div><label class="label">Categoría</label><select name="category_id" id="cat-select" class="input"></select></div>
        <div><label class="label">Descripción</label><textarea name="description" rows="3" class="input resize-none"></textarea></div>
        <input type="hidden" name="image_url" />
        <div class="flex gap-6">
          <label class="flex items-center gap-2 text-sm"><span class="switch"><input type="checkbox" name="is_active" data-default="true" /><span></span></span>Activo</label>
          <label class="flex items-center gap-2 text-sm"><span class="switch"><input type="checkbox" name="is_featured" /><span></span></span>Destacado ⭐</label>
        </div>
        <div class="flex justify-between gap-2 pt-2">
          <button type="button" id="del" class="btn-ghost btn-sm !text-danger">Eliminar</button>
          <div class="flex gap-2"><button type="button" data-close class="btn-ghost btn-sm">Cancelar</button><button id="save" class="btn-primary btn-sm">Guardar</button></div>
        </div>
      </form>
    </dialog>
  )}
</AdminLayout>

<script>
  import { sb, admin, isOwner, esc, money, toast, check, readForm, fillForm } from '../../scripts/admin.js';

  const db = sb();
  const me = admin();
  const $ = (id) => document.getElementById(id);
  let products = [], categories = [], branches = [], overrides = new Map();

  async function init() {
    [categories, branches] = await Promise.all([
      db.from('categories').select('id,name,emoji').order('sort').then(check),
      db.from('branches').select('id,name').order('sort').then(check),
    ]);
    const visible = isOwner() ? branches : branches.filter((b) => b.id === me.branch_id);
    $('branch').innerHTML = visible.map((b) => `<option value="${b.id}">📍 ${esc(b.name)}</option>`).join('');
    if (!isOwner()) $('branch').disabled = true;
    if ($('cat-select')) $('cat-select').innerHTML = '<option value="">Sin categoría</option>' + categories.map((c) => `<option value="${c.id}">${c.emoji} ${esc(c.name)}</option>`).join('');
    await load();
  }

  async function load() {
    const bid = $('branch').value;
    const [p, o] = await Promise.all([
      db.from('products').select('*').order('sort').order('name').then(check),
      bid ? db.from('product_branches').select('*').eq('branch_id', bid).then(check) : [],
    ]);
    products = p;
    overrides = new Map(o.map((x) => [x.product_id, x]));
    render();
  }

  function render() {
    const q = $('search').value.toLowerCase();
    const catOf = Object.fromEntries(categories.map((c) => [c.id, c]));
    const list = products.filter((p) => !q || p.name.toLowerCase().includes(q));
    $('rows').innerHTML = list.map((p) => {
      const o = overrides.get(p.id);
      const avail = o ? o.is_available : true;
      const c = catOf[p.category_id];
      return `<tr data-id="${p.id}" class="${p.is_active ? '' : 'opacity-50'}">
        <td class="td"><div class="flex items-center gap-3">
          <span class="size-11 rounded-xl bg-surface-2 overflow-hidden grid place-items-center text-xl shrink-0">${p.image_url ? `<img src="${esc(p.image_url)}" class="size-full object-cover" alt="">` : (c?.emoji ?? '🍔')}</span>
          <div><p class="font-semibold">${esc(p.name)} ${p.is_featured ? '⭐' : ''}</p><p class="text-xs text-muted line-clamp-1 max-w-xs">${esc(p.description)}</p></div>
        </div></td>
        <td class="td text-muted">${c ? `${c.emoji} ${esc(c.name)}` : '—'}</td>
        <td class="td">${money(p.price)}</td>
        <td class="td"><label class="switch"><input type="checkbox" data-avail ${avail ? 'checked' : ''}><span></span></label></td>
        <td class="td"><input data-price type="number" min="0" step="100" placeholder="${p.price}" value="${o?.price_override ?? ''}" class="input !py-1.5 !w-28 text-sm"></td>
        ${isOwner() ? `<td class="td"><label class="switch"><input type="checkbox" data-active ${p.is_active ? 'checked' : ''}><span></span></label></td>
        <td class="td text-right"><button data-edit class="btn-ghost btn-sm">Editar</button></td>` : ''}
      </tr>`;
    }).join('') || `<tr><td class="td text-muted" colspan="7">No hay productos.</td></tr>`;
  }

  async function upsertOverride(pid, patch) {
    const bid = $('branch').value;
    const cur = overrides.get(pid) ?? { product_id: pid, branch_id: bid, is_available: true, price_override: null };
    const row = { ...cur, ...patch };
    check(await db.from('product_branches').upsert(row));
    overrides.set(pid, row);
    toast('Guardado');
  }

  $('rows').addEventListener('change', async (e) => {
    const tr = e.target.closest('tr'); const pid = tr?.dataset.id; if (!pid) return;
    if (e.target.matches('[data-avail]')) upsertOverride(pid, { is_available: e.target.checked });
    if (e.target.matches('[data-price]')) upsertOverride(pid, { price_override: e.target.value === '' ? null : Number(e.target.value) });
    if (e.target.matches('[data-active]')) {
      check(await db.from('products').update({ is_active: e.target.checked }).eq('id', pid));
      products.find((p) => p.id === pid).is_active = e.target.checked; render(); toast('Actualizado');
    }
  });
  $('branch').addEventListener('change', load);
  $('search').addEventListener('input', render);

  // ─── Crear / editar (solo owner) ───
  const dlg = $('dlg');
  if (dlg) {
    const form = $('form');
    let file = null;
    const open = (p = {}) => {
      file = null; fillForm(form, p);
      $('dlg-title').textContent = p.id ? 'Editar producto' : 'Nuevo producto';
      $('del').classList.toggle('invisible', !p.id);
      $('preview').src = p.image_url || ''; $('preview').classList.toggle('hidden', !p.image_url);
      dlg.showModal();
    };
    $('new').onclick = () => open();
    $('rows').addEventListener('click', (e) => { if (e.target.closest('[data-edit]')) open(products.find((p) => p.id === e.target.closest('tr').dataset.id)); });
    dlg.querySelectorAll('[data-close]').forEach((b) => (b.onclick = () => dlg.close()));
    $('file').onchange = (e) => {
      file = e.target.files[0]; if (!file) return;
      if (file.size > 3 * 1024 * 1024) { toast('Máximo 3 MB', false); file = null; return; }
      $('preview').src = URL.createObjectURL(file); $('preview').classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = $('save'); btn.disabled = true;
      try {
        const data = readForm(form);
        if (file) {
          const ext = file.name.split('.').pop().toLowerCase();
          const path = `${crypto.randomUUID()}.${ext}`;
          check(await db.storage.from('products').upload(path, file, { cacheControl: '31536000', upsert: false }));
          data.image_url = db.storage.from('products').getPublicUrl(path).data.publicUrl;
        }
        const { id, ...row } = data;
        if (id) check(await db.from('products').update(row).eq('id', id));
        else check(await db.from('products').insert(row));
        dlg.close(); toast('Producto guardado'); load();
      } finally { btn.disabled = false; }
    });

    $('del').onclick = async () => {
      const id = form.elements.id.value;
      if (!id || !confirm('¿Eliminar este producto? Los pedidos anteriores se conservan.')) return;
      check(await db.from('products').delete().eq('id', id));
      dlg.close(); toast('Eliminado'); load();
    };
  }

  init();
</script>
