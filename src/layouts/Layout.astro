---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { PUBLIC_BRAND_NAME } from 'astro:env/client';

const { title, description = 'Hamburguesas, salchipapas y perros a domicilio. Pide en segundos, sin registrarte.', hideCart = false } = Astro.props;
const fullTitle = title ? `${title} · ${PUBLIC_BRAND_NAME}` : `${PUBLIC_BRAND_NAME} · Comida rápida a domicilio`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f0d0b" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body class="antialiased">
    <Header hideCart={hideCart} />
    <main><slot /></main>
    <Footer />
    {!hideCart && <CartDrawer />}

    <div id="toast" role="status" aria-live="polite"
      class="fixed left-1/2 -translate-x-1/2 bottom-24 md:bottom-8 z-[70] flex items-center gap-2 rounded-full bg-ink text-bg px-5 py-3 font-semibold shadow-2xl transition-all duration-300 opacity-0 translate-y-4 pointer-events-none">
      <span data-icon>✓</span><span data-msg></span>
    </div>
  </body>
</html>
